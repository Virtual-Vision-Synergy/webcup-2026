includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Traits réutilisables, utilisés par les composants des fonctionnalités (et par les tests)
        -
            identifier: trait.unused
            paths:
                - app/Concerns/ExportsCsv.php
                - app/Concerns/ThrottlesPerUser.php
                - app/Concerns/BloqueSiServiceIndisponible.php
